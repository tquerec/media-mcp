# Copy this file to .env (which is gitignored) and fill in your own values.
# A service's tools are only enabled when its API key is set.
# API keys are in each app under Settings > General (SABnzbd: Config > General).

# --- Sonarr (TV) ---
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# --- Radarr (movies) ---
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# --- Lidarr (music) ---
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=

# --- SABnzbd (downloads) ---
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=

# --- Server options ---
# true = only expose read-only tools (no adding media, no pausing downloads)
MEDIA_MCP_READ_ONLY=false
# Request timeout in seconds
MEDIA_MCP_TIMEOUT=30
# Transport: stdio (default, for Claude Desktop / Claude Code) or streamable-http
MEDIA_MCP_TRANSPORT=stdio
# Only used with streamable-http. Keep 127.0.0.1 unless you know you need otherwise.
MEDIA_MCP_HOST=127.0.0.1
MEDIA_MCP_PORT=8765

# --- Remote access (Claude mobile, Claude on other computers) ---
# Leave these empty to keep the server local-only. To enable, put a tunnel in front of
# 127.0.0.1:MEDIA_MCP_PORT (see README) and set its public HTTPS URL here. A password
# login (OAuth) is then required for every client.
MEDIA_MCP_PUBLIC_URL=
# Generate with:  uv run media-mcp hash-password
MEDIA_MCP_PASSWORD_HASH=
# Where OAuth clients and token hashes are kept between restarts (gitignored).
MEDIA_MCP_STATE_FILE=.media-mcp-auth.json
# Hosts allowed as OAuth redirect targets (default: claude.ai,claude.com,localhost,127.0.0.1)
MEDIA_MCP_ALLOWED_REDIRECT_HOSTS=
