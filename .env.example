# Copy this file to .env (which is gitignored) and fill in your own values.
# A service's tools are only enabled when its API key is set.
# API keys are in each app under Settings > General (SABnzbd: Config > General).

# --- Sonarr (TV) ---
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# --- Radarr (movies) ---
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# --- Lidarr (music) ---
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=

# --- SABnzbd (downloads) ---
SABNZBD_URL=http://localhost:8080
SABNZBD_API_KEY=

# --- Server options ---
# true = only expose read-only tools (no adding media, no pausing downloads)
MEDIA_MCP_READ_ONLY=false
# Request timeout in seconds
MEDIA_MCP_TIMEOUT=30
# Transport: stdio (default, for Claude Desktop / Claude Code) or streamable-http
MEDIA_MCP_TRANSPORT=stdio
# Only used with streamable-http. 127.0.0.1 = this computer only.
# 0.0.0.0 = also other devices on your network (requires MEDIA_MCP_BEARER_TOKEN).
MEDIA_MCP_HOST=127.0.0.1
MEDIA_MCP_PORT=8765
# Shared secret that HTTP clients must send as "Authorization: Bearer <token>".
# Generate with:  uv run media-mcp new-token
MEDIA_MCP_BEARER_TOKEN=
